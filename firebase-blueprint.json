{
  "entities": {
    "Invoice": {
      "title": "Invoice",
      "description": "Represents a customer invoice generated by a user",
      "type": "object",
      "properties": {
        "invoiceNumber": { "type": "string" },
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "customerEmail": { "type": "string" },
        "issueDate": { "type": "string" },
        "dueDate": { "type": "string" },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "taxRate": { "type": "number" },
        "taxAmount": { "type": "number" },
        "discountRate": { "type": "number" },
        "discountAmount": { "type": "number" },
        "total": { "type": "number" },
        "status": { "type": "string" },
        "notes": { "type": "string" },
        "userId": { "type": "string" },
        "createdAt": { "type": "object" },
        "updatedAt": { "type": "object" }
      },
      "required": ["invoiceNumber", "customerId", "customerName", "customerEmail", "issueDate", "dueDate", "items", "subtotal", "total", "status", "userId"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Represents a client profile created by a user",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "company": { "type": "string" },
        "address": { "type": "string" },
        "userId": { "type": "string" },
        "createdAt": { "type": "object" }
      },
      "required": ["name", "email", "userId"]
    },
    "Product": {
      "title": "Product",
      "description": "Represents a service or product that can be billed on invoices",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "rate": { "type": "number" },
        "userId": { "type": "string" },
        "createdAt": { "type": "object" }
      },
      "required": ["name", "rate", "userId"]
    },
    "Settings": {
      "title": "Settings",
      "description": "User's business/company configurations",
      "type": "object",
      "properties": {
        "companyName": { "type": "string" },
        "companyEmail": { "type": "string" },
        "companyPhone": { "type": "string" },
        "companyAddress": { "type": "string" },
        "taxId": { "type": "string" },
        "paymentDetails": { "type": "string" },
        "currency": { "type": "string" },
        "userId": { "type": "string" },
        "logoUrl": { "type": "string" }
      },
      "required": ["companyName", "companyEmail", "userId"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile managed by current user",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": "string" },
        "companyName": { "type": "string" },
        "companyAddress": { "type": "string" },
        "companyGst": { "type": "string" },
        "companyPhone": { "type": "string" },
        "logoUrl": { "type": "string" },
        "invoiceFooter": { "type": "string" },
        "invoiceNotes": { "type": "string" },
        "brandColor": { "type": "string" },
        "pdfTemplateId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "email"]
    }
  },
  "firestore": {
    "/invoices/{invoiceId}": {
      "schema": "Invoice",
      "description": "Customer invoices managed by users"
    },
    "/customers/{customerId}": {
      "schema": "Customer",
      "description": "Client list managed by users"
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Billing products managed by users"
    },
    "/settings/{settingsId}": {
      "schema": "Settings",
      "description": "Company invoices billing profiles"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Authorized user profile"
    }
  }
}
